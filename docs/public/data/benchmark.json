    "emptyResults": "show-reason-and-reset"
  },
  "invariants": [
    "三个风格必须使用本文件全部成员、任务、状态、日期和数值",
    "不得增删功能入口来制造风格差异",
    "状态修改只留在本地会话，重置后回到本基准",
    "空结果不能用改数据或占位任务来回避"
  ],
  "prompt": {
    "id": "task-workbench-v1-prompt",
    "text": "使用技能「多风格界面设计」，按给定风格参数实现同一个任务管理工作台。必须完整使用 benchmark.json（id: task-workbench-v1）中的工作区、成员、状态、优先级、任务、指标和功能；默认选中 t-101；默认视图为列表。允许的布局仅为 list-detail 或 board-detail。启用能力：搜索筛选、列表/看板切换、选中详情、状态本地修改、清空重置、空结果。不要增删改业务对象，不要用不同数据或不同功能表现风格差异，不要把第三方原图当作实现界面，不要使用 emoji 作为图标。输出可运行界面或等价前端代码，并注明所用风格标识。",
    "calls": [
      {
        "id": "call-shallow-precise",
        "style": "shallow-precise",
        "styleName": "浅色精密工作台",
        "layout": "list-detail"
      },
      {
        "id": "call-dark-command",
        "style": "dark-command",
        "styleName": "深色指挥台",
        "layout": "list-detail"
      },
      {
        "id": "call-soft-system",
        "style": "soft-system",
        "styleName": "浮动系统层",
        "layout": "list-detail"
      }
    ],
    "variableOnly": "style",
    "note": "三次调用只改变 style / styleName，其余输入保持一致。"
  },
  "traceTemplate": {
    "skillName": "多风格界面设计",
    "skillVersion": "",
    "input": {
      "style": "",
      "layout": "",
      "benchmarkId": "task-workbench-v1"
    },
    "outputPath": "",
    "testTrace": "",
    "rule": "没有真实发生的生成或测试，不要填写输出或结果。"
  }
}
